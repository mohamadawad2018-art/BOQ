rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Pillar 3: Path & ID validation primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPassLookupId(id) {
      return id is string && id.size() == 32 && id.matches('^[a-f0-9]+$');
    }

    function isValidOptionalDate(val) {
      return val is string && val.size() <= 10 && val.matches('^(|[0-9]{4}-[0-9]{2}-[0-9]{2})$');
    }

    function isValidHexOrEmpty(val, maxLen) {
      return val is string && val.size() <= maxLen && val.matches('^[a-f0-9]*$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Strictly verified owner admin check (blocks unverified email spoofing)
    function isOwnerAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'mohamad.awad.2018@gmail.com';
    }

    // Pillar 2: Validation Blueprints (Anti-Update-Gap)
    function isValidAccessControl(data) {
      return data.keys().hasAll([
          'isActive',
          'pauseMessage',
          'ownerSignature',
          'passcodeEnabled',
          'passcodeSalt',
          'passcodeHash',
          'passcodeVersion',
          'updatedBy',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'isActive',
          'pauseMessage',
          'ownerSignature',
          'passcodeEnabled',
          'passcodeSalt',
          'passcodeHash',
          'passcodeVersion',
          'updatedBy',
          'updatedAt'
        ])
        && data.isActive is bool
        && data.pauseMessage is string
        && data.pauseMessage.size() <= 300
        && data.ownerSignature is string
        && data.ownerSignature.size() <= 120
        && data.passcodeEnabled is bool
        && isValidHexOrEmpty(data.passcodeSalt, 64)
        && isValidHexOrEmpty(data.passcodeHash, 128)
        && data.passcodeVersion is int
        && data.passcodeVersion >= 1
        && data.passcodeVersion <= 1000000
        && data.updatedBy is string
        && data.updatedBy == request.auth.uid
        && isValidId(data.updatedBy)
        && data.updatedAt is timestamp;
    }

    function isValidOwnerAccessKey(data) {
      return data.keys().hasAll([
          'label',
          'passLookupId',
          'active',
          'expiresAt',
          'version',
          'createdBy',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'label',
          'passLookupId',
          'active',
          'expiresAt',
          'version',
          'createdBy',
          'createdAt',
          'updatedAt'
        ])
        && data.label is string
        && data.label.size() >= 1
        && data.label.size() <= 80
        && isValidPassLookupId(data.passLookupId)
        && data.active is bool
        && isValidOptionalDate(data.expiresAt)
        && data.version is int
        && data.version >= 1
        && data.version <= 1000000
        && data.createdBy is string
        && data.createdBy == request.auth.uid
        && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAccessPass(data) {
      return data.keys().hasAll([
          'active',
          'expiresAt',
          'version',
          'verifySalt',
          'verifyHash',
          'updatedBy',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'active',
          'expiresAt',
          'version',
          'verifySalt',
          'verifyHash',
          'updatedBy',
          'updatedAt'
        ])
        && data.active is bool
        && isValidOptionalDate(data.expiresAt)
        && data.version is int
        && data.version >= 1
        && data.version <= 1000000
        && data.verifySalt is string
        && data.verifySalt.size() >= 16
        && data.verifySalt.size() <= 64
        && data.verifySalt.matches('^[a-f0-9]+$')
        && data.verifyHash is string
        && data.verifyHash.size() >= 64
        && data.verifyHash.size() <= 128
        && data.verifyHash.matches('^[a-f0-9]+$')
        && data.updatedBy is string
        && data.updatedBy == request.auth.uid
        && isValidId(data.updatedBy)
        && data.updatedAt is timestamp;
    }

    // 1. Single-document global access control (/app_config/access_control)
    match /app_config/{docId} {
      allow get: if isValidId(docId) && docId == 'access_control';
      allow list: if false;

      allow create: if isOwnerAdmin()
        && isValidId(docId)
        && docId == 'access_control'
        && isValidAccessControl(incoming())
        && incoming().updatedAt == request.time;

      allow update: if isOwnerAdmin()
        && isValidId(docId)
        && docId == 'access_control'
        && isValidAccessControl(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'isActive',
          'pauseMessage',
          'ownerSignature',
          'passcodeEnabled',
          'passcodeSalt',
          'passcodeHash',
          'passcodeVersion',
          'updatedBy',
          'updatedAt'
        ])
        && incoming().updatedAt == request.time;

      allow delete: if false;
    }

    // 2. Owner-private named access keys (/owner_access_keys/{keyId})
    match /owner_access_keys/{keyId} {
      allow get: if isOwnerAdmin() && isValidId(keyId);
      allow list: if isOwnerAdmin() && resource.data.createdBy == request.auth.uid;

      allow create: if isOwnerAdmin()
        && isValidId(keyId)
        && isValidOwnerAccessKey(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/access_passes/$(incoming().passLookupId));

      allow update: if isOwnerAdmin()
        && isValidId(keyId)
        && isValidOwnerAccessKey(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().passLookupId == existing().passLookupId
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'label',
          'active',
          'expiresAt',
          'version',
          'updatedAt'
        ])
        && incoming().updatedAt == request.time;

      allow delete: if isOwnerAdmin()
        && isValidId(keyId)
        && !existsAfter(/databases/$(database)/documents/access_passes/$(existing().passLookupId));
    }

    // 3. Blind-lookup zero-PII verification passes (/access_passes/{passLookupId})
    match /access_passes/{passLookupId} {
      allow get: if isValidPassLookupId(passLookupId);
      allow list: if false;

      allow create: if isOwnerAdmin()
        && isValidPassLookupId(passLookupId)
        && isValidAccessPass(incoming())
        && incoming().updatedAt == request.time;

      allow update: if isOwnerAdmin()
        && isValidPassLookupId(passLookupId)
        && isValidAccessPass(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'active',
          'expiresAt',
          'version',
          'verifySalt',
          'verifyHash',
          'updatedBy',
          'updatedAt'
        ])
        && incoming().updatedAt == request.time;

      allow delete: if isOwnerAdmin()
        && isValidPassLookupId(passLookupId);
    }
  }
}
